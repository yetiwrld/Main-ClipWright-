{
  "name": "@clipwright/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Clipwright Studio Desktop Application",
  "author": "Clipwright Studio",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && vite build --config vite.main.config.ts",
    "typecheck": "tsc --noEmit",
    "dist:win": "pnpm build && electron-builder --win nsis portable --x64 --publish never",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.main.config.ts"
  },
  "dependencies": {
    "@clipwright/ai-core": "workspace:*",
    "@clipwright/audio-core": "workspace:*",
    "@clipwright/caption-styles": "workspace:*",
    "@clipwright/compositor": "workspace:*",
    "@clipwright/design-system": "workspace:*",
    "@clipwright/export-core": "workspace:*",
    "@clipwright/media-core": "workspace:*",
    "@clipwright/project-schema": "workspace:*",
    "@clipwright/timeline-engine": "workspace:*",
    "@clipwright/update-core": "workspace:*",
    "better-sqlite3": "^11.8.0",
    "electron-updater": "^6.3.9",
    "immer": "^10.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "electron": "^34.2.0"
  }
}
