{
  "name": "clipwright-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Clipwright Studio — Turn a long video into captioned, edited short clips and edit multitrack video offline",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/lint-design-tokens.mjs && node scripts/no-fakes-audit.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:exports": "tsx scripts/verify/export-matrix.ts",
    "dev": "pnpm --filter @clipwright/desktop dev",
    "dist:win": "pnpm --filter @clipwright/desktop dist:win"
  },
  "devDependencies": {
    "@ffmpeg-installer/linux-x64": "4.1.0",
    "@ffprobe-installer/linux-x64": "5.2.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/bangers": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.8.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "fast-check": "^3.23.2",
    "immer": "^10.1.1",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  }
}
